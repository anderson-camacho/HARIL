{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["scripts/tests/fixtures/**"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/**/index.ts"]
    },
    "packages/core": {
      "entry": ["src/**/index.ts", "testing/**/*.ts"]
    },
    "integrations/*": {
      "entry": ["src/**/index.ts"]
    },
    "integrations/git": { "ignoreDependencies": ["@haril/contracts"] },
    "integrations/state-sqlite": {
      "entry": ["src/**/index.ts", "tests/crash/*.mjs"]
    },
    "integrations/agent-pi": { "ignoreDependencies": ["@haril/contracts"] },
    "integrations/pi-console": {
      "entry": ["src/console.ts"]
    },
    "apps/*": {
      "entry": ["src/**/index.ts"]
    },
    "apps/bootstrap": {
      "entry": ["src/**/index.ts", "src/main.ts"]
    },
    "apps/haril": {
      "entry": ["src/**/index.ts", "src/main.ts", "tests/crash/*.mjs"],
      "ignoreBinaries": ["tte"]
    },
    "apps/shell": {
      "entry": ["src/main.ts"]
    }
  }
}
